# Byte-compiled files / caches
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environment
.venv/

# Local data and generated artifacts (never commit financial files)
data/
backups/
exports/

# Generated build output (PyInstaller): see portfoliox.spec
build/
dist/

# Personal reference material: broker statements, contract notes, ledgers
# (readme policy: never commit real tradebooks, contract notes, or financial files)
referance/
referance notes/

# --- Privacy hardening: AI/agent directories (never track) ---
# These hold local credentials, prompts, workflow notes, and vendored
# third-party skill bundles. None of it is project source.
.clinerules/
.opencode/
.cline/
.claude/
.codex/
.gemini/
.cursor/

# --- Build logs and stray scripts ---
build_log.txt
build_output.txt
/bypass

# --- Installer output (Inno Setup) ---
installer/Output/

# --- Environment files (keep .env.example as a tracked template) ---
.env
.env.*
!.env.example

# --- Logs ---
*.log

# --- Git bundles (backups, never commit) ---
*.bundle

# --- Python test/caches ---
.pytest_cache/
.coverage
htmlcov/

# --- IDE state ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# --- OS files ---
.DS_Store
Thumbs.db
